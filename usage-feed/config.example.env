# Copy to usage-feed/.env.local (git-ignored) and fill in. Never commit the real file.
CF_ACCOUNT_ID=your-cloudflare-account-id
KV_NAMESPACE_ID=your-kv-namespace-id
WORKER_NAME=grokbot-usage-feed
WORKERS_SUBDOMAIN=your-subdomain            # <WORKER_NAME>.<WORKERS_SUBDOMAIN>.workers.dev
TOKEN_FILE=$HOME/.grokbot-usage-feed/token.env  # local file holding FEED_TOKEN=..., mode 600
# CLOUDFLARE_API_TOKEN comes from your shell environment, not this file.
