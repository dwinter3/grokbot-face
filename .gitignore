android/vendor/*.aar
android/vendor/vosk-model-*/
android/vendor/*.zip
sense/mp/wasm/
sense/mp/models/
sense/mp/vision_bundle.mjs
sense/mp/LICENSE

# media, scratch, editors
*.mp4
*.bak*
node_modules/
.gradle/
.DS_Store
