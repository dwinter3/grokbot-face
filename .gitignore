# secrets and local config (never commit)
*.keystore
*.jks
*.p12
*.pem
*.key
.env
.env.*
!config.example.env
local.env
usage-feed/.env.local
usage-feed/wrangler.toml
.wrangler/
.dev.vars

# build outputs
android/build/
android/src/assets/
*.apk
*.idsig
*.aab

